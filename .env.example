# VulnEm configuration — copy to .env and fill in.
# litellm reads provider keys from the environment. Any litellm provider works;
# unlisted providers follow the <PREFIX>_API_KEY convention (vulnem/providers.py
# holds the catalog: key vars, keyless locals, example models).

# LLM in litellm format: <provider>/<model>
VULNEM_LLM=openai/gpt-5

# Optional: route every provider call through an OpenAI-compatible endpoint
# (ollama, vLLM, LiteLLM proxy, gateways):
# VULNEM_API_BASE=http://localhost:11434/v1

# Example provider keys (set the one matching VULNEM_LLM):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
# GROQ_API_KEY=...
# GEMINI_API_KEY=...
# MISTRAL_API_KEY=...
# DEEPSEEK_API_KEY=...
# XAI_API_KEY=...
# PERPLEXITYAI_API_KEY=...
# TOGETHERAI_API_KEY=...
# FIREWORKS_AI_API_KEY=...
# COHERE_API_KEY=...

# Skip the interactive authorization confirmation (CI / labs):
# VULNEM_YES=1
