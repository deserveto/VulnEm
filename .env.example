# VulnEm configuration — copy to .env and fill in.
# litellm reads provider keys from the environment (OPENAI_API_KEY, ANTHROPIC_API_KEY, ...).

# LLM in litellm format: <provider>/<model>
VULNEM_LLM=openai/gpt-5

# Example provider keys (set the one matching VULNEM_LLM):
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Skip the interactive authorization confirmation (CI / labs):
# VULNEM_YES=1
